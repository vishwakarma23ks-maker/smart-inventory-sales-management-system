# ============================================================
# SmartStock environment variables
# ============================================================
# Copy this file to ".env" for local development, or set these
# variables directly in the Render dashboard (no .env upload needed).

# 1) SECRET_KEY (required)
#    Used by Flask to encrypt session cookies. Generate one with:
#       python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-value

# 2) DATABASE_URL (optional)
#    Leave EMPTY to use a local SQLite file (smartstock.db).
#    Set a URL to use a managed database instead:
#
#    Render free tier (PostgreSQL) - recommended for production:
#       postgresql://<user>:<pass>@<host>:5432/<dbname>
#
#    Local XAMPP / MariaDB / MySQL:
#       mysql+pymysql://root:<your-password>@127.0.0.1:3306/smartstock_inventory
DATABASE_URL=
